# Only needed when [label] enabled = true. Set the pair matching your provider.

# label.provider = "foundry"  — Claude on Microsoft Foundry.
# Both values come from the Azure AI Foundry portal, for a resource that has a
# Claude model deployed.
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=

# label.provider = "azure-openai"  — GPT on Azure OpenAI.
#
# ENDPOINT is the resource *base* URL:
#     https://my-resource.openai.azure.com/
#     https://my-resource.services.ai.azure.com/     (AI Foundry resources)
#
# The portal often shows a full operation URL instead, e.g.
#     https://my-resource.services.ai.azure.com/openai/v1/responses
# That is rejected with a message naming the base URL to use instead: the SDK
# builds its own /openai/... path, and silently trimming the value here would
# mean the endpoint in this file is not the endpoint in use.
#
# Set label.deployment in config.toml to your *deployment* name, chosen when you
# deployed; it need not match the model id. `littax doctor --probe` lists the
# deployments on your resource if the name is wrong.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
